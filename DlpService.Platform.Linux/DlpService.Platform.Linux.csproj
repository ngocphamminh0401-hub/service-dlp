<Project Sdk="Microsoft.NET.Sdk">

  <!-- [Thay đổi] File mới (GĐ2 bước 2.2, docs/ke-hoach-trien-khai-linux.md mục 5.3): ADAPTER LINUX cho các interface nền tảng của Core
       (IPathPolicy, IDataFolderGuard, IAppLayout) + hàm đăng ký AddLinuxPlatform(). Tách thành class library (không để trong host) để
       project test tham chiếu được mà không kéo theo một file chạy thứ hai (trùng Program/appsettings.json với host Windows). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DlpService.Platform.Linux</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DlpService.Core\DlpService.Core.csproj" />
  </ItemGroup>

  <!-- [Thay đổi] GĐ3: test kiểm thứ tự ưu tiên cấu hình (LinuxHost.AddSystemConfigFile là internal) -->
  <ItemGroup>
    <InternalsVisibleTo Include="DlpService.Tests" />
  </ItemGroup>

  <!-- AddLinuxPlatform() mở rộng HostApplicationBuilder + gọi AddSystemd() -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
  </ItemGroup>
</Project>
