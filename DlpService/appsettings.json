{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Scan": {
    "MinConfidence": 0.60
  },
  "Score": {
    "THigh": 0.80,
    "TLow": 0.10
  },
  "Storage": {
    "DbPath": "data/dlp.db"
  },
  "Watch": {
    "MaxConcurrency": 6,
    "Folders": [ "D:/Service-DLP/watch-folder" ]
  },
  "TikaNative": {
    "Enabled": false,
    "Mode": "Supplement",
    "Isolates": 2,
    "DllPath": "native/tika/tika_native.dll",
    "Sha256": "",
    "RequireSha256": true,
    "TimeoutMs": 30000,
    "MaxChars": 2000000
  },
  "Llm": {
    "PipeName": "dlp-llm-host",
    "JobDeadlineSeconds": 600,
    "MinTextChars": 200,
    "ExcludedPaths": [],
    "SuspiciousKeywords": [ "luong", "bangluong", "hopdong", "nhansu", "password", "matkhau", "backup", "cccd", "salary" ],
    "SampleRatePct": 2,
    "CacheDays": 90,
    "JobRetentionDays": 30,
    "AuditRetentionDays": 180,
    "CleanupIntervalHours": 24,
    "Quota": { "P1PerHour": 200, "P2PerDay": 300, "P3PerDay": 50, "MaxPendingJobs": 1000 }
  }
}
