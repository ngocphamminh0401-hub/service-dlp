{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Scan": {
    "MinConfidence": 0.60,
    // [Thay đổi] M4: trần thời gian quét regex cho CẢ 1 file (mọi rule cộng lại). Chạm trần → file ghi "incomplete" (scan_budget), cần xem lại.
    "MaxSecondsPerFile": 10
  },
  "Score": {
    "THigh": 0.80,
    "TLow": 0.10
  },
  "Storage": {
    "DbPath": "data/dlp.db",
    // [Thay đổi] M1: false = không khoá được quyền thư mục DB thì service DỪNG (exit code 1). Chỉ đặt true khi chạy thử/dev.
    "AllowUnprotectedDataFolder": false
  },
  "Watch": {
    "MaxConcurrency": 6,
    "Folders": [ "D:/Service-DLP/watch-folder" ],
    // [Thay đổi] M5: thư mục gốc mất liên tục quá N giờ hoặc bản ghi nằm ngoài mọi thư mục theo dõi quá N giờ → xoá bản ghi
    "RootMissingGraceHours": 24
  },
  // [Thay đổi] H4: ngân sách giải nén file Office (.docx/.pptx/.xlsx là ZIP) — chặn zip bomb và file làm service vượt RAM (MemoryMax=512M).
  // Vượt ngân sách → file được ghi "incomplete" (limit_exceeded, mức Unknown, cần xem lại), không đọc. Đơn vị MB.
  "Reading": {
    "Zip": {
      "MaxEntries": 10000,
      "MaxCentralDirectoryMB": 8,
      // docx/pptx nạp cả XML thành cây đối tượng (RAM ≈ 5–10 × XML)
      "DomMaxEntryMB": 24,
      "DomMaxTotalMB": 48,
      // xlsx đọc sheet theo từng hàng; riêng sharedStrings bị nạp hết vào RAM
      "StreamingMaxEntryMB": 256,
      "StreamingMaxSharedStringsMB": 24,
      "StreamingMaxTotalMB": 512,
      "MaxTotalAllEntriesMB": 1024,
      "MaxCompressionRatio": 200,
      "RatioCheckMinMB": 1
    }
  },
  "TikaNative": {
    "Enabled": false,
    "Mode": "Supplement",
    "Isolates": 2,
    "DllPath": "native/tika/tika_native.dll",
    "Sha256": "",
    "RequireSha256": true,
    "TimeoutMs": 30000,
    "MaxChars": 2000000
  },
  "Llm": {
    "PipeName": "dlp-llm-host",
    "JobDeadlineSeconds": 600,
    "MinTextChars": 200,
    "ExcludedPaths": [],
    "SuspiciousKeywords": [ "luong", "bangluong", "hopdong", "nhansu", "password", "matkhau", "backup", "cccd", "salary" ],
    "SampleRatePct": 2,
    "CacheDays": 90,
    "JobRetentionDays": 30,
    "AuditRetentionDays": 180,
    "CleanupIntervalHours": 24,
    "Quota": { "P1PerHour": 200, "P2PerDay": 300, "P3PerDay": 50, "MaxPendingJobs": 1000 }
  }
}
