<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-DlpService-6ad53db3-d5d6-453c-adcb-6df54e8ec239</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="PdfPig" Version="0.1.11" />
    <!-- [Thay đổi] mục 5 - Client gRPC nói chuyện với LLM process qua Named Pipe (Llm/InferenceClient.cs) -->
    <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
    <PackageReference Include="Grpc.Tools" Version="2.66.0" PrivateAssets="All" />
    <PackageReference Include="Google.Protobuf" Version="3.28.2" />
    <!-- [Thay đổi] mục 4.12 - đọc CPU toàn máy (Llm/MachineIdleChecker.cs) -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.0" />
  </ItemGroup>

  <!-- [Thay đổi] Sinh code Client (không cần Server — DlpService chỉ GỌI LLM process, không đóng vai LLM) từ hợp
       đồng đã chốt contracts/inference.proto -->
  <ItemGroup>
    <Protobuf Include="..\contracts\inference.proto" GrpcServices="Client" ProtoRoot="..\contracts" />
  </ItemGroup>

  <!-- [Thay đổi] Copy mọi file rule JSON (kể cả trong thư mục con theo domain như rules/hr, rules/financial)
       ra thư mục chạy để RuleLoader tìm thấy trong <thư mục chạy>/rules -->
  <ItemGroup>
    <None Update="rules\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- [Thay đổi] FileConfidence 2 nhánh: hệ số + bảng độ chính xác rule (confidence/file-confidence-v1.json) -->
    <None Update="confidence\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- [Thay đổi] Tika native: cho project test truy cập các lớp internal của Reading/Native (TikaNativeRuntime.ResetForTests...) -->
  <ItemGroup>
    <InternalsVisibleTo Include="DlpService.Tests" />
  </ItemGroup>

  <!-- [Thay đổi] Tika native: đóng gói tika_native.dll (và các DLL phụ của JDK nếu có) vào thư mục native\tika cạnh service.
       CHỈ khi build/publish với -p:BundleTikaNative=true (VD: dotnet publish -p:BundleTikaNative=true), vì DLL nặng khoảng 100 MB
       và nhiều dự án công cụ (tools\*) cùng tham chiếu DlpService — nếu copy mặc định, MỖI thư mục build đều phình thêm 100 MB.
       Chuẩn bị DLL bằng tools\tika-native\stage-native.cmd (copy từ tools\tika-native\build vào DlpService\native\tika). -->
  <ItemGroup Condition="'$(BundleTikaNative)' == 'true'">
    <None Include="native\tika\*.dll" Link="native\tika\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
