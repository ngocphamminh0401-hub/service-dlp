{
  // [Thay đổi] File mới (GĐ2 bước 2.1): cấu hình bản Linux. Khác bản Windows: LLM tắt, FileConfidence tắt, 2 file cùng lúc (D6),
  // không có thư mục theo dõi mặc định, DB theo bố cục (không ghi "Storage:DbPath").
  // Chế độ System (cài gói, file chạy ở /opt/dlp-service): /etc/dlp-service/appsettings.json được đọc SAU file này → ghi đè được mọi mục.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Scan": {
    "MinConfidence": 0.60
  },
  "Score": {
    "THigh": 0.80,
    "TLow": 0.10
  },
  // [Thay đổi] GĐ2 bước 2.2c: KHÔNG đặt "Storage:DbPath" → dùng mặc định của bố cục: Portable = <thư mục chạy>/data/dlp.db,
  // System = /var/lib/dlp-service/dlp.db. (Để chuỗi rỗng "" sẽ SAI: Worker chỉ dùng mặc định khi mục này không có.)
  "Watch": {
    // D6: mặc định 2 file cùng lúc trên máy người dùng Linux (Windows đang là 6)
    "MaxConcurrency": 2,
    // Cố ý để trống: đường dẫn phụ thuộc từng máy. Nhận mẫu * cho từng cấp (R8), VD "/home/*/Documents". Truyền khi chạy thử:
    //   dotnet run --project DlpService.Host.Linux -- --Watch:Folders:0=$HOME/dlp-watch
    // hoặc biến môi trường: Watch__Folders__0=/home/*/Documents
    "Folders": [],
    // [Thay đổi] GĐ3: nguồn sự kiện — "inotify" (mặc định, DlpService.Platform.Linux) hoặc "fsw" (FileSystemWatcher của .NET, dự phòng)
    "Backend": "inotify",
    // [Thay đổi] GĐ3 (3.2): không theo dõi / không quét thư mục ẩn và các thư mục rác thường gặp — mỗi thư mục con tốn 1 inotify watch
    "SkipHidden": true,
    "ExcludeDirectoryNames": [ "node_modules", "__pycache__", "venv", "site-packages", "snap", "Trash" ],
    // [Thay đổi] GĐ3 (3.3): quét đối soát toàn bộ mỗi 60 phút — lưới an toàn cho sự kiện bị mất (file không đổi chỉ tốn 1 lần đọc size/mtime)
    "ReconcileIntervalMinutes": 60,
    // [Thay đổi] GĐ3 (3.5): mở rộng lại mẫu (VD /home/*/Documents) mỗi 60 giây để bắt người dùng mới
    "PatternRefreshSeconds": 60,
    // [Thay đổi] GĐ3 (3.6): 1 dòng [Metric] mỗi 60 giây (chỉ số, không đường dẫn)
    "MetricsIntervalSeconds": 60
  },
  "TikaNative": {
    // D8: Tika native trên Linux để GĐ5 (cần build libtika_native.so)
    "Enabled": false
  },
  "FileConfidence": {
    // [Thay đổi] GĐ2 (R11): chỉ một hệ chấm điểm (S1 + Router) trên Linux
    "Enabled": false
  },
  "Llm": {
    // Mục 4.2: bản Linux không có LLM → vùng xám ghi final + needs_review, không tạo llm_job
    "Enabled": false
  }
}
