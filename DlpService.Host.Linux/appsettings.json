{
  // [Thay đổi] File mới (GĐ2 bước 2.1): cấu hình bản Linux. Khác bản Windows: LLM tắt, 2 file cùng lúc (D6), không có thư mục theo dõi mặc định.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Scan": {
    "MinConfidence": 0.60
  },
  "Score": {
    "THigh": 0.80,
    "TLow": 0.10
  },
  "Storage": {
    "DbPath": "data/dlp.db"
  },
  "Watch": {
    // D6: mặc định 2 file cùng lúc trên máy người dùng Linux (Windows đang là 6)
    "MaxConcurrency": 2,
    // Cố ý để trống: đường dẫn phụ thuộc từng máy. Truyền khi chạy, VD:
    //   dotnet run --project DlpService.Host.Linux -- --Watch:Folders:0=$HOME/dlp-watch
    // hoặc biến môi trường: Watch__Folders__0=/home/ten/Documents
    "Folders": []
  },
  "TikaNative": {
    // D8: Tika native trên Linux để GĐ5 (cần build libtika_native.so)
    "Enabled": false
  },
  "Llm": {
    // Mục 4.2: bản Linux không có LLM → vùng xám ghi final + needs_review, không tạo llm_job
    "Enabled": false
  }
}
