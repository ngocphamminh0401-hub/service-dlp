<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- [Thay đổi] File mới (GĐ2 bước 2.1, docs/ke-hoach-trien-khai-linux.md mục 5.3): HOST LINUX mỏng. Chỉ tham chiếu Core (KHÔNG tham chiếu
       DlpService — đó là host Windows, kéo theo gRPC/LLM/PerformanceCounter). Không có LLM trên Linux (mục 4.2). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Tên file chạy: dlp-service (theo bố cục /opt/dlp-service ở mục 5.4) thay vì DlpService.Host.Linux -->
    <AssemblyName>dlp-service</AssemblyName>
    <RootNamespace>DlpService.Host.Linux</RootNamespace>
  </PropertyGroup>

  <!-- [Thay đổi] GĐ2 bước 2.2d: adapter Linux + systemd nằm ở DlpService.Platform.Linux (tham chiếu bắc cầu tới Core) -->
  <ItemGroup>
    <ProjectReference Include="..\DlpService.Core\DlpService.Core.csproj" />
    <ProjectReference Include="..\DlpService.Platform.Linux\DlpService.Platform.Linux.csproj" />
  </ItemGroup>
</Project>
