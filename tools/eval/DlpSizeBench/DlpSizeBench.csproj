<!-- [Thay đổi] File mới (hạng mục 3 — ảnh hưởng của kích thước và định dạng file): sinh bộ dữ liệu CÓ NHÃN gồm 7 định dạng ×
     nhiều bậc kích thước từ mẫu rawdata, rồi đo thời gian / bộ nhớ / độ chính xác bằng ĐÚNG pipeline của service.
     Tham chiếu thẳng DlpService (rule, extractor, scanner, engine; PdfPig dùng để ghi PDF). -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DlpSizeBench</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\DlpService\DlpService.csproj" />
  </ItemGroup>

  <!-- [Thay đổi] Đo lại với Tika native: tham số extractor (legacy hoặc tika) dùng chung giữa các công cụ đo -->
  <ItemGroup>
    <Compile Include="..\..\shared\ExtractorSwitch.cs" Link="ExtractorSwitch.cs" />
  </ItemGroup>

</Project>
