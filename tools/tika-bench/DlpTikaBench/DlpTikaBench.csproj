<!-- [Thay đổi] File mới: công cụ benchmark so sánh Apache Tika Server với các extractor hiện tại của DlpService.
     Tham chiếu thẳng DlpService để dùng ĐÚNG FileReaderService + RegexScanner của service, không chép lại logic.
     Thư mục rules/ của DlpService được copy theo sang thư mục chạy (giống DlpBaseline). -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DlpTikaBench</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\DlpService\DlpService.csproj" />
  </ItemGroup>

  <!-- [Thay đổi] Đo lại sau khi sửa lỗi Tika: tham số extractor (legacy, supplement hoặc tika) dùng chung giữa các công cụ đo -->
  <ItemGroup>
    <Compile Include="..\..\shared\ExtractorSwitch.cs" Link="ExtractorSwitch.cs" />
  </ItemGroup>

</Project>
