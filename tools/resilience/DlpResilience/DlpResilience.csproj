<!-- [Thay đổi] File mới: công cụ test chịu lỗi — kill service / worker giữa chừng rồi khởi động lại, kiểm tra không mất job,
     không xử lý trùng gây sai, DB không hỏng. Tham chiếu DlpService → DlpService.exe (+ rules, appsettings) được copy sang
     thư mục chạy của tool, tool chạy ĐÚNG service thật như 1 process riêng rồi kill nó. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DlpResilience</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\DlpService\DlpService.csproj" />
  </ItemGroup>

</Project>
